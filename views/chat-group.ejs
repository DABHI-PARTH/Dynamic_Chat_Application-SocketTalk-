<!doctype html>
<html lang="en">
<head>
    <title>SocketTalk</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="icon" type="image/png" href="/Chat_App/images/logo.png">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }
        .highlighted {
            border-radius: 20px;
            background-color: rgba(61, 114, 184, 0.1);
        }
        .cursor-pointer {
            cursor: pointer;
        }
        .group-list-item {
            transition: all 0.3s ease;
            margin-bottom: 5px;
        }
        .chat-section {
            display: none;
            padding: 15px;
            margin-bottom: 15px;
            background-color: #ffffff;
            box-shadow: 0 0 10px rgba(0,0,0,0.05);
        }
        #chat-container {
            min-height: 300px;
            max-height: 60vh;
            padding: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 10px;
            background-color: #fafafa;
            margin-bottom: 15px;
            overflow-y: auto;
        }
        .owner-badge {
            background-color: #9df39e;
            color: #212529;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 12px;
            margin-left: 10px;
            font-weight: bold;
        }
        .joined-badge {
            background-color: #17a2b8;
            color: white;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 12px;
            margin-left: 10px;
            font-weight: bold;
        }
        .message-input {
            margin-top: -10px;
            display: flex;
            align-items: center;
        }
        .message-input input[type="text"] {
            flex-grow: 1;
            border-radius: 30px;
            padding: 12px 20px;
            border: 1px solid #ced4da;
            font-size: 15px;
            margin-right: 8px;
        }
        .message-input input[type="submit"] {
            border-radius: 30px;
            padding: 8px 20px;
            font-size: 14px;
            background-color: #006DFB;
            border: none;
            color: #fff;
            transition: 0.3s ease;
            
        }
        .message-input input[type="submit"]:hover {
            background-color: #004ea8;
        }
        h3.start-head {
            color: #0C356A;
            font-weight: 600;
            font-size: 22px;
        }
        
        .time {
            color: #666;
            font-size: 10px;
            margin-top: 5px;
            
        }
        .fa-trash{
            margin-left: 10px;
        }
        .fa-edit{
            margin-left: -10px;
        }

        .tag {
    font-size: smaller;
    color: #666;
    
}

.tag img {
    border-radius: 50%;
    width: 25px;
    height: 25px;
    object-fit: cover;
    border: 1px solid rgba(0, 0, 0, 0.1);
    margin-right: 10px;
}
.c-usertag{
    margin-right: -10px;
}
    </style>
</head>
<body>
    <%- include('layouts/header.ejs') %>

      <!-- Delete Chat Modal -->
      <div class="modal fade" id="deleteChatModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Delete Chat</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form id="delete-chat-form">
                    <div class="modal-body">
                        <input type="hidden" name="id" id="delete-message-id">       
                        <p>Are you sure to delete this message?</p>
                        <p><b id="delete-message"></b></p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="canc-btn" data-dismiss="modal">Close</button>
                        <button type="submit" id="del-btn" class="btn btn-danger">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Update Model -->
    <div class="modal fade" id="editChatModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLongTitle">Edit Chat</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <form id="update-chat-form">
                    <div class="modal-body">
                        <input type="hidden" name="id" id="edit-message-id"> 
                        <p><b id="update-message"></b></p>      
                        <input type="text" name="message" id="update-message-text" required placeholder="Enter message">   
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" id="canc-btn" data-dismiss="modal">Close</button>
                        <button type="submit" id="upd-btn" class="btn btn-primary" >Edit</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <div class="container-fluid mt-3">
        <h2 class="mb-4"><span style="color:#0C356A; font-size: 40px;">Group Chat</span></h2>
        <div class="row">
            <div class="col-md-3">
                <ul class="list-group">
                    <% if(myGroups.length > 0 || joinedGroups.length > 0) { %>
                        <% for(let i = 0; i < myGroups.length; i++) { %>
                            <li class="list-group-item group-list-item cursor-pointer user-list"
                                data-id="<%= myGroups[i]['_id'] %>">
                                <img src="<%= myGroups[i]['image'] %>" 
                                     alt="<%= myGroups[i]['name'] %>" 
                                     width="50" height="50" style="border-radius: 50%;">
                                <span style="font-size: 18px; font-family: cursive; color:#0C356A;">
                                    <%= myGroups[i]['name'] %>
                                </span>
                                <span class="owner-badge">Owner</span>
                            </li>
                        <% } %>
                        <% for(let i = 0; i < joinedGroups.length; i++) { %>
                            <li class="list-group-item group-list-item cursor-pointer user-list"
                                data-id="<%= joinedGroups[i]['group_id']['_id'] %>">
                                <img src="<%= joinedGroups[i]['group_id']['image'] %>" 
                                     alt="<%= joinedGroups[i]['group_id']['name'] %>" 
                                     width="50" height="50" style="border-radius: 50%;">
                                <span style="font-size: 18px; font-family: cursive; color: #0C356A;">
                                    <%= joinedGroups[i]['group_id']['name'] %>
                                </span>
                                <span class="joined-badge">Joined</span>
                            </li>
                        <% } %>
                    <% } else { %>
                        <li class="list-group-item">No groups available. Join or create a group to start chatting.</li>
                    <% } %>
                </ul>
            </div>

            <div class="col-md-9">
                <h3 class="start-head">Select a group to start chatting</h3>
                <div class="chat-section">
                    <div id="chat-container"></div>
                    <form id="chat-form" class="message-input">
                        <input type="text" name="message" placeholder="Type your message" id="message" required style="width:200px;">
                        <input type="submit" value="  Send  ">
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        var $jq = jQuery.noConflict(); 
        var sender_id = '<%= user._id %>';
        var global_group_id = null;
        var current_group_name = '';

        var socket = io('/user-namespace', {
            auth: { token: sender_id }
        });

        
        $jq(document).ready(function() {
            // Group selection handler
            $jq('.user-list').click(function() {
                $jq('.start-head').hide();
                $jq('.chat-section').show();
                global_group_id = $jq(this).attr('data-id');
                current_group_name = $jq(this).find('span').first().text();
                
                // Reset UI state
                $jq('.user-list').removeClass('highlighted');
                $jq(this).addClass('highlighted');
                
                // Clear and load new chats
                $jq('#chat-container').empty();
                loadGroupChats();
            });

            function formatMessage(message) {
                if (!message) return '';
                let formattedMessage = '';
                let messageLength = message.length;
                for (let i = 0; i < messageLength; i += 40) {
                    formattedMessage += message.slice(i, i + 30) + '<br>';
                }
                return formattedMessage;
            }

            // Message submission handler
            $jq('#chat-form').submit(function(event) {
                event.preventDefault(); 

                var message = $jq('#message').val().trim();  
                if (message === '') {
                    return; 
                }

                let formattedMessage = formatMessage(message);

                $jq.ajax({
                    url: './group-save-chat',  
                    type: 'POST',
                    data: { 
                        sender_id: sender_id, 
                        group_id: global_group_id, 
                        message: message
                    },
                    success: function(response) {
                        if (response.success) {
                            $jq('#message').val('');  
                            
                            let html = ` 
                                <div class="current-user-chat" id='${response.chat._id}'>
                                    <div class="chat-box" id='${response.chat._id}'>
                                        <h5 id='${response.chat._id}'>${formattedMessage}</h5> 
                                    </div>
                                 
                                     <i class="fa fa-trash" id="trash-btn" aria-hidden="true" data-id='${response.chat._id}' data-toggle="modal" data-target="#deleteChatModal"></i>
                                         <i class="fa fa-edit" id="edit-btn" aria-hidden="true" data-id='${response.chat._id}' data-toggle="modal" data-target="#editChatModal"></i>
                                          <h4 class="tag c-usertag">
                                          <img src="<%= user.image %>" >Me
                                        </h4>
                                    <h4 class="time">${formatTime(response.chat.updatedAt)}</h4>        
                                </div>
                            `;
                            $jq('#chat-container').append(html);
                            socket.emit('newGroupChat', response.chat); 
                            scrollchat();
                        } else {
                            alert(response.msg || 'Failed to send message');  
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Error sending message:', error);
                        alert('Failed to send message. Please try again.');
                    }
                });
            });

            // Load group chats function
            function loadGroupChats() {
    if (!global_group_id) return;

    $jq.ajax({
        url: "./load-group-chats",
        type: "POST",
        data: {
            group_id: global_group_id,
        },
        success: function(res) {
            if (res.success && Array.isArray(res.chats)) {
                var chats = res.chats;
                var html = '';

                chats.forEach(chat => {
                    const isCurrentUser = chat.sender_id._id.toString() === sender_id.toString();
                    let className = isCurrentUser ? 'current-user-chat' : 'distance-user-chat';
                    let formattedMessage = formatMessage(chat.message);

                    html += `<div class="${className}" id="${chat._id}">
                                <div class="chat-box" id="${chat._id}">
                                    <h5 id="${chat._id}">${formattedMessage}</h5>      
                                </div>`;

                    if (isCurrentUser) {
                        html += `<i class="fa fa-trash" id="trash-btn" aria-hidden="true"
                                    data-id='${chat._id}' data-toggle="modal"
                                    data-target="#deleteChatModal"></i>
                                <i class="fa fa-edit" id="edit-btn" aria-hidden="true" 
                                    data-id='${chat._id}' data-toggle="modal" 
                                    data-target="#editChatModal"></i>
                                <h4 class="tag c-usertag" >
                                    <img src="${chat.sender_id.image}">  Me         
                                </h4>`;
                    } else {
                        html += `<h4 class="tag">
                                    <img src="${chat.sender_id.image}">${chat.sender_id.name}
                                </h4>`;
                    }

                    html += `<h4 class="time">${formatTime(chat.updatedAt)}</h4>        
                            </div>`;
                });

                $jq('#chat-container').html(html);
                scrollchat();
            } else {
                console.warn("No chats found:", res.msg);
            }
        },
        error: function(xhr, status, error) {
            console.error("Error loading chats:", error);
            alert("Failed to load chats. Please try again.");
        }
    });
}

            // Format time display
            function formatTime(dateString) {
    if (!dateString) return '';
    const date = new Date(dateString);
    const options = { 
        year: 'numeric', 
        month: 'short', 
        day: 'numeric', 
        hour: '2-digit', 
        minute: '2-digit' 
    };
    return date.toLocaleString(undefined, options);
}

$jq(document).on('click', '.fa-trash', function() {
                let msg = $jq(this).parent().find('.chat-box h5').html();  
                let messageId = $jq(this).attr('data-id');  
                 
                $jq('#delete-message').html(msg);  
                $jq('#delete-message-id').val(messageId); 
            });
            $jq('#delete-chat-form').submit(function(event){
                event.preventDefault();

                var id = $jq('#delete-message-id').val();
                $jq.ajax({
                    url: './delete-group-chat',
                    type: 'POST',
                    data: { id: id},
                    success: function(res) {
                        if (res.success == true) {
                            $jq('#'+id).remove();
                            socket.emit('groupChatDeleted',id);
                            if($jq('#canc-btn').click()){
                                $jq('#deleteChatModal').hide();
                                $jq('#deleteChatModal').click();
                                $jq('#canc-btn').click();
                            }
                        } else {
                            alert(res.msg);  
                        }
                    },
                    error: function() {
                        alert("Error deleting message.");
                    }
                });
            });

            $jq(document).on('click','.fa-edit',function(){
                let msg = $jq(this).parent().find('.chat-box h5').html();  
                let messageId = $jq(this).attr('data-id');  

                $jq('#update-message').html(msg);  
                $jq('#edit-message-id').val(messageId);  
            });

            $jq('#update-chat-form').submit(function(event){
                event.preventDefault();
                var id = $jq('#edit-message-id').val();
                var updmsg = $jq('#update-message-text').val();

                $jq.ajax({
                    url: './update-group-chat',
                    type: 'POST',
                    data: { id: id,message:updmsg},
                    success: function(res) {
                        if (res.success == true) {
                            function formatMessage(message) {
                                let formattedMessage = '';
                                let messageLength = message.length;
                                for (let i = 0; i < messageLength; i += 40) {
                                    formattedMessage += message.slice(i, i + 30) + '<br>';
                                }
                                return formattedMessage;
                            }
                            let msg=formatMessage(updmsg);
                            
                            $jq('#'+id).find('h5').html(msg);
                            if($jq('#canc-btn').click()){
                                $jq('#editChatModal').hide();
                                $jq('#editChatModal').click();
                                $jq('#canc-btn').click();
                            }
                             
                            $jq('#update-chat-form')[0].reset();
                            socket.emit('groupChatUpdated',{id:id,message:msg});
                            
                        } else {
                            alert(res.msg);  
                        }
                    },
                });
            });
















            // Socket handler for new group chats
            socket.on('loadNewGroupChat', function(data){
               
                if (global_group_id && data.group_id && global_group_id === data.group_id) {
                    let formattedMessage = formatMessage(data.message); 
                    let className = data.sender_id == sender_id ? 
                                   'current-user-chat' : 'distance-user-chat';

                    // Check if message already exists to prevent duplicates
                    if (!$jq(`#${data._id}`).length) {
                        let html = `
                            <div class="${className}" id='${data._id}'>
                                <div class="chat-box" id='${data._id}'>
                                    <h5 id='${data._id}'>${formattedMessage}</h5>
                                </div>
                                
                                <h4 class="time">${formatTime(data.updatedAt)}</h4>
                            </div>
                        `;
                        $jq('#chat-container').append(html);
                        loadGroupChats();
                    }
                }
            });

            socket.on('groupChatMessageDeleted',function(id){
                $jq('#' + id).remove();
                $jq('#chat-container').html('');  
                loadGroupChats();
            });
           
            socket.on('groupChatMessageUpdated', function(data){
                $jq('#'+data.id).find('h5').html(data.msg)
                $jq('#chat-container').html('');  
                loadGroupChats();
            });

            // Scroll to bottom of chat container
            function scrollchat() {
                var container = $jq('#chat-container');
                container.scrollTop(container[0].scrollHeight);
                
            }
        });
    </script>

    <%- include('layouts/footer.ejs') %>
</body>
</html>


