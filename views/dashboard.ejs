<!doctype html>
<html lang="en">
<head>
    <title>SocketTalk</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="icon" type="image/png" href="/Chat_App/images/logo.png">
   
   
</head>
<body>
    <%- include('layouts/header.ejs') %>
    <h2 class="mb-4" style="margin-top: 10px;">
        <span style="color:rgb(0, 161, 224); font: 50px sans-serif;">Hi</span>,
        <span style="color:#0C356A; font-family: cursive; font-size: 40px;"> <%= user.name %> </span>
    </h2>

    <div class="row">
        <div class="col-md-2.5">
            <ul class="list-group">
                <% if(users.length > 0){ %>
                    <% for(let i = 0; i < users.length; i++) { %>
                        <li class="list-group-item list-group-item-dark cursor-pointer user-list" data-id="<%= users[i]['_id'] %>">
                            <img src="<%= users[i]['image'] %>" alt="<%= users[i]['name'] %>" width="50px" height="50px">
                            <span style="font-size: 20px; font-family: cursive;"> <%= users[i]['name'] %> </span>
                            <% if (users[i]['is_online'] == 'Online') { %>
                                <sub class="online-status" id="<%= users[i]['_id'] %>-status">🟢Online</sub>
                            <% } else { %>
                                <sub class="offline-status" id="<%= users[i]['_id'] %>-status">🔴Offline</sub>
                            <% } %>
                        </li>
                    <% } %>
                <% } %>
            </ul>
        </div>
        <div class="col-md-9">
            <h3 class="start-head" style="color: #0C356A">Click to start the Chat</h3>
            <div class="chat-section">
                <div id="chat-container"></div>
                <div id="reply-preview">
                    <span class="replying-to"></span>
                    <button id="cancel-reply" class="btn btn-sm btn-danger">×</button>
                </div>
                <form action="" id="chat-form">
                    <input type="hidden" name="replyTo" id="replyTo" value="">
                    <input type="hidden" name="repliedMessage" id="repliedMessage" value="">
                    <input type="text" name="message" placeholder="Enter Message" id="message" class="border" required> 
                    <input type="submit" value="Send Message" class="btn btn-primary">
                </form>
            </div>
        </div>
    </div>

 <!--Model-->
<!-- Delete Chat Modal -->
<div class="modal fade" id="deleteChatModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Delete Chat</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form id="delete-chat-form">
                <div class="modal-body">
                    <input type="hidden" name="id" id="delete-message-id">       
                    <p>Are you sure to delete this message?</p>
                    <p><b id="delete-message"></b></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" id="canc-btn" data-dismiss="modal">Close</button>
                    <button type="submit" id="del-btn" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!--Update Model-->
<div class="modal fade" id="editChatModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Edit Chat</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="update-chat-form">
                <div class="modal-body">
                    <input type="hidden" name="id" id="edit-message-id"> 
                    <p><b id="update-message"></b></p>      
                    <input type="text" name="message" id="update-message-text" required placeholder="Enter message">   
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" id="canc-btn" data-dismiss="modal">Close</button>
                    <button type="submit" id="upd-btn" class="btn btn-primary" >Edit</button>
                </div>
            </form>
        </div>
    </div>
</div>


    <script>
        var $jq = jQuery.noConflict(); 
        var sender_id = '<%= user._id %>';
        var receiver_id;
        var socket; 

        $jq(document).ready(function() {
            socket = io('/user-namespace', {
                auth: {
                    token: sender_id,
                }
            });

            // Function to format message with line breaks
            function formatMessage(message) {
                let formattedMessage = '';
                let messageLength = message.length;
                for (let i = 0; i < messageLength; i += 40) {
                    formattedMessage += message.slice(i, i + 30) + '<br>';
                }
                return formattedMessage;
            }

            // Function to create reply button (now using icon)
            function createReplyButton(messageId, messageContent) {
                return `<i class="fa fa-reply reply-icon" aria-hidden="true" data-id="${messageId}" data-message="${messageContent}" title="Reply"></i>`;
            }

            // Function to format reply message
            function formatReplyMessage(message) {
                return formatMessage(message).replace(/<br>/g, ' ');
            }

            // Function to show reply preview
            function showReplyPreview(messageId, messageContent) {
                $jq('#reply-preview .replying-to').html("Replying to: " + formatReplyMessage(messageContent));
                $jq('#replyTo').val(messageId);
                $jq('#repliedMessage').val(messageContent);
                $jq('#reply-preview').show();
                $jq('#message').focus();
            }

            // Cancel reply
            $jq('#cancel-reply').click(function(e) {
                e.preventDefault();
                $jq('#reply-preview').hide();
                $jq('#replyTo').val('');
                $jq('#repliedMessage').val('');
            });

            // Click on reply button (now icon)
            $jq(document).on('click', '.reply-icon', function() {
                const messageId = $jq(this).data('id');
                const messageContent = $jq(this).data('message');
                showReplyPreview(messageId, messageContent);
            });

            $jq('.user-list').click(function() {
                var userId = $jq(this).attr('data-id');
                receiver_id = userId;
                $jq('.start-head').hide();
                $jq('.chat-section').show();
                $jq('.user-list').removeClass('highlighted');
                $jq(this).addClass('highlighted');
                socket.emit('oldChat', {sender_id: sender_id, receiver_id: receiver_id});
            });

            socket.on('getOnlineUser', (data) => {
                $jq('#' + data.user_id + '-status').text('🟢Online');
                $jq('#' + data.user_id + '-status').removeClass('offline-status');
                $jq('#' + data.user_id + '-status').addClass('online-status');
            });

            socket.on('getOfflineUser', (data) => {
                $jq('#' + data.user_id + '-status').text('🔴Offline');
                $jq('#' + data.user_id + '-status').removeClass('online-status');
                $jq('#' + data.user_id + '-status').addClass('offline-status');
            });

            $jq('#chat-form').submit(function(event) {
                event.preventDefault(); 

                var message = $jq('#message').val();  
                if (message.trim() === '') {
                    return; 
                }

                let formattedMessage = formatMessage(message);
                const replyTo = $jq('#replyTo').val();
                const repliedMessage = $jq('#repliedMessage').val();

                $jq.ajax({
                    url: './save-chat',  
                    type: 'POST',
                    data: { 
                        sender_id: sender_id, 
                        receiver_id: receiver_id, 
                        message: message,
                        replyTo: replyTo,
                        repliedMessage: repliedMessage
                    },
                    success: function(response) {
                        if (response.success) {
                            $jq('#message').val('');  
                            $jq('#reply-preview').hide();
                            $jq('#replyTo').val('');
                            $jq('#repliedMessage').val('');
                            
                            let chat = response.data.message;
                            let html = ` 
                                <div class="current-user-chat" id='${response.data._id}'>
                                    ${response.data.isReply ? 
                                        `<div class="reply-container">Replying to: ${formatReplyMessage(response.data.repliedMessage)}</div>` : ''}
                                    <div class="chat-box" id='${response.data._id}'>
                                        <h5 id='${response.data._id}'>${formattedMessage}</h5> 
                                    </div>
                                    <i class="fa fa-trash" id="trash-btn" aria-hidden="true" data-id='${response.data._id}' data-toggle="modal" data-target="#deleteChatModal"></i>
                                    <i class="fa fa-edit" id="edit-btn" aria-hidden="true" data-msg="${formattedMessage}" data-id='${response.data._id}' data-toggle="modal" data-target="#editChatModal"></i>
                                    ${createReplyButton(response.data._id, chat)}
                                    <h4 class="time" style="font-size: 8px;">${response.data.updatedAt}</h4>        
                                </div>
                            `;

                            $jq('#chat-container').append(html);
                            socket.emit('newChat', response.data); 
                            scrollchat();
                        } else {
                            alert(response.msg);  
                        }
                    }
                });
            });

            socket.on('loadNewChat', function(data){
                if (sender_id === data.receiver_id && receiver_id === data.sender_id) {
                    let formattedMessage = formatMessage(data.message); 

                    let html = `
                        <div class="distance-user-chat" id='${data._id}'>
                            ${data.isReply ? 
                                `<div class="reply-container">Replying to: ${formatReplyMessage(data.repliedMessage)}</div>` : ''}
                            <div class="chat-box" id='${data._id}'>
                                <h5 id='${data._id}'>${formattedMessage}</h5>
                            </div>
                            ${createReplyButton(data._id, data.message)}
                            <h4 class="time" style="font-size: 8px;">${data.updatedAt}</h4>
                        </div>
                    `;
                    $jq('#chat-container').append(html);
                    scrollchat();
                }
            });

            socket.on('loadChats', (data) => {
                $jq('#chat-container').html('');
                var chats = data.chats;
                let html = '';

                for (let x = 0; x < chats.length; x++) {
                    let addClass = '';
                    let formattedMessage = formatMessage(chats[x]['message']);
                    
                    if (chats[x]['sender_id'] == sender_id) {
                        addClass = 'current-user-chat';  
                        html += `
                            <div class='${addClass}' id='${chats[x]['_id']}'>
                                ${chats[x].isReply ? 
                                    `<div class="reply-container">Replying to: ${formatReplyMessage(chats[x].repliedMessage)}</div>` : ''}
                                <div class="chat-box" id='${chats[x]['_id']}'>
                                    <h5 id='${chats[x]['_id']}'>${formattedMessage}</h5>
                                </div>
                                <i class="fa fa-trash" aria-hidden="true" id="trash-btn" data-id='${chats[x]['_id']}' data-toggle="modal" data-target="#deleteChatModal"></i>
                                <i class="fa fa-edit" id="edit-btn" aria-hidden="true" data-id='${chats[x]['_id']}' data-toggle="modal" data-target="#editChatModal"></i>
                                ${createReplyButton(chats[x]['_id'], chats[x]['message'])}
                                <h4 class='time' style="font-size: 8px;">${chats[x]['updatedAt']}</h4>
                            </div>
                        `;
                    } else {
                        addClass = 'distance-user-chat';  
                        html += `
                            <div class='${addClass}' id='${chats[x]['_id']}'>
                                ${chats[x].isReply ? 
                                    `<div class="reply-container">Replying to: ${formatReplyMessage(chats[x].repliedMessage)}</div>` : ''}
                                <div class="chat-box" id='${chats[x]['_id']}'>
                                    <h5 id='${chats[x]['_id']}'>${formattedMessage}</h5>
                                </div>
                                ${createReplyButton(chats[x]['_id'], chats[x]['message'])}
                                <h4 class='time' style="font-size: 8px;">${chats[x]['updatedAt']}</h4>
                            </div>
                        `;
                    }
                }
                $jq('#chat-container').append(html);
                scrollchat();
            });

            $jq(document).on('click', '.fa-trash', function() {
                let msg = $jq(this).parent().find('.chat-box h5').html();  
                let messageId = $jq(this).attr('data-id');  

                $jq('#delete-message').html(msg);  
                $jq('#delete-message-id').val(messageId); 
            });

            $jq('#delete-chat-form').submit(function(event){
                event.preventDefault();

                var id = $jq('#delete-message-id').val();
                $jq.ajax({
                    url: './delete-chat',
                    type: 'POST',
                    data: { id: id},
                    success: function(res) {
                        if (res.success == true) {
                            $jq('#'+id).remove();
                            $jq('#canc-btn').click();
                            $jq('#deleteChatModal').hide();
                            socket.emit('ChatDeleted',id);
                        } else {
                            alert(res.msg);  
                        }
                    },
                    error: function() {
                        alert("Error deleting message.");
                    }
                });
            });

            $jq(document).on('click','.fa-edit',function(){
                let msg = $jq(this).parent().find('.chat-box h5').html();  
                let messageId = $jq(this).attr('data-id');  

                $jq('#update-message').html(msg);  
                $jq('#edit-message-id').val(messageId);  
            });

            $jq('#update-chat-form').submit(function(event){
                event.preventDefault();
                var id = $jq('#edit-message-id').val();
                var updmsg = $jq('#update-message-text').val();

                $jq.ajax({
                    url: './update-chat',
                    type: 'POST',
                    data: { id: id,message:updmsg},
                    success: function(res) {
                        if (res.success == true) {
                            function formatMessage(message) {
                                let formattedMessage = '';
                                let messageLength = message.length;
                                for (let i = 0; i < messageLength; i += 40) {
                                    formattedMessage += message.slice(i, i + 30) + '<br>';
                                }
                                return formattedMessage;
                            }
                            let msg=formatMessage(updmsg);
                            
                            $jq('#'+id).find('h5').html(msg);
                            if($jq('#canc-btn').click()){
                                $jq('#editChatModal').hide();
                                $jq('#editChatModal').click();
                                $jq('#canc-btn').click();
                            }
                             
                            $jq('#update-chat-form')[0].reset();
                            socket.emit('chatUpdated',{id:id,message:msg});
                            
                        } else {
                            alert(res.msg);  
                        }
                    },
                });
            });

            function scrollchat() {
                $jq('#chat-container').animate({
                    scrollTop: $jq('#chat-container').offset().top + $jq('#chat-container')[0].scrollHeight
                }, 0);
            }
            
            socket.on('chatmsgdel', (data) => {
                $jq('#' + data.id).remove();
                $jq('#chat-container').html('');  
                socket.emit('oldChat', { sender_id: sender_id, receiver_id: receiver_id }); 
            });

            socket.on('chatMessageUpdated', function(data){
                $jq('#'+data.id).find('h5').html(data.msg)
                $jq('#chat-container').html('');  
                socket.emit('oldChat', { sender_id: sender_id, receiver_id: receiver_id }); 
            });
        }); 
    </script>

    <%- include('layouts/footer.ejs') %>
</body>
</html>