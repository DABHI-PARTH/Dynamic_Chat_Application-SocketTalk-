<link rel="icon" type="image/png" href="/Chat_App/images/logo.png">
<%- include('layouts/header.ejs') %>
<h2 class="mb-4">Hi,<span style="color: #5f9ae7;; font-size:50px; font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;"><%= user.name  %></span></h2>

<div class="row">
    <div class="col-md-3">
        <ul class="list-group">
            <% if(users.length > 0){ %>
                <% for(let i = 0; i < users.length; i++) { %>
                    <li class="list-group-item list-group-item-dark">
                        <img src="<%= users[i]['image'] %>" alt="<%= users[i]['name'] %>" width="50px" height="50px">
                        <%= users[i]['name'] %>
                    </li>
                <% } %>

            <% } %>
        </ul>
    </div>
    <div class="col-md-9">
        
    </div>
</div>

<%- include('layouts/footer.ejs') %>
